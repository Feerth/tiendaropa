# Base de datos (Supabase PostgreSQL)
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# NextAuth
# En desarrollo: http://localhost:3000
# En Vercel: agregar variable de entorno NEXTAUTH_URL = https://tudominio.com
NEXTAUTH_URL=http://localhost:3000
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=

# Instagram (público)
NEXT_PUBLIC_INSTAGRAM_USERNAME=nov4sk_

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud

# Vercel KV (Upstash Redis) — opcional, para rate limiting en producción
# Se configura desde Vercel Dashboard → Storage → KV (Upstash Redis)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Admin inicial (solo usado en seed — cambia estos valores)
ADMIN_EMAIL=admin@tutienda.com
ADMIN_PASSWORD=CambiaPorUnaContraseñaSegura123!
