# Base de datos (Supabase PostgreSQL)
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# NextAuth
# En desarrollo: http://localhost:3000
# En Vercel: agregar variable de entorno NEXTAUTH_URL = https://tudominio.com
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generar_con_node_-e_console.log(require('crypto').randomBytes(32).toString('hex'))

# WhatsApp (público)
NEXT_PUBLIC_WHATSAPP_NUMBER=51931869696

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud

# Vercel KV (Upstash Redis) — opcional, para rate limiting en producción
# Se configura desde Vercel Dashboard → Storage → KV (Upstash Redis)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Admin inicial (solo usado en seed)
ADMIN_EMAIL=admin@tiendaropa.com
ADMIN_PASSWORD=Admin123!
